@model List<EMS.MVC.Models.Employee>

<div class="container mt-5">

    <h2 class="mb-4 text-primary">Employee Management</h2>

    <a href="/Employee/Create" class="btn btn-success mb-3">+ Add Employee</a>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Salary</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var emp in Model)
                {
                    <tr>
                        <td>@emp.Id</td>
                        <td>@emp.Name</td>
                        <td>₹ @emp.Salary</td>
                        <td>
                            <a href="/Employee/Delete/@emp.Id" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">No employees found</td>
                </tr>
            }
        </tbody>
    </table>

</div>