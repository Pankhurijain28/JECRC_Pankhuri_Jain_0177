@model FoodOrdering.MVC.ViewModels.CheckoutViewModel

<div class="container mt-4">

    <h2>Checkout</h2>

    <form method="post">

        <div class="mb-3">
            <label>Name</label>

            <input asp-for="CustomerName"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Email</label>

            <input asp-for="CustomerEmail"
                   class="form-control" />
        </div>

        <button type="submit"
                class="btn btn-success">

            Place Order

        </button>

    </form>

</div>