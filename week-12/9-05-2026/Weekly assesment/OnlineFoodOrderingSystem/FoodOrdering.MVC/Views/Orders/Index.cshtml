@model List<FoodOrdering.MVC.ViewModels.OrderViewModel>

<div class="container mt-4">

    <h1 class="food-title">
        📦 Order History
    </h1>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">

            No orders found.

        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="card order-card shadow-lg mb-4">

                <div class="order-header">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h4 class="mb-1">
                                Order #@order.Id
                            </h4>

                            <p class="mb-0">
                                @order.CustomerName
                            </p>

                        </div>

                        <div>

                            <span class="badge bg-light text-dark fs-6">

                                @order.Status

                            </span>

                        </div>

                    </div>

                </div>

                <div class="card-body">

                    <div class="row mb-3">

                        <div class="col-md-6">

                            <strong>Email:</strong>
                            @order.CustomerEmail

                        </div>

                        <div class="col-md-6 text-md-end">

                            <strong>Date:</strong>
                            @order.OrderDate.ToString("dd MMM yyyy hh:mm tt")

                        </div>

                    </div>

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Food Item</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in order.OrderItems)
                            {
                                <tr>

                                    <td>
                                        @item.FoodName
                                    </td>

                                    <td>
                                        ₹ @item.Price
                                    </td>

                                    <td>
                                        @item.Quantity
                                    </td>

                                    <td>
                                        ₹ @(item.Price * item.Quantity)
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                    <div class="d-flex justify-content-between align-items-center mt-4">

                        <h4 class="food-price m-0">

                            Grand Total:
                            ₹ @order.TotalAmount

                        </h4>

                        <a asp-action="DownloadInvoice"
                               asp-route-id="@order.Id"
                               class="btn btn-dark">

                            <i class="fa-solid fa-file-pdf"></i>
                            Download Invoice PDF

                        </a>

                    </div>

                </div>

            </div>
        }
    }